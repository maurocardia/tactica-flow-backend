PORT=5000
NODE_ENV=development

# Database PostgreSQL
PG_HOST=sakura.proxy.rlwy.net
PG_PORT=19251
PG_USER=postgres
PG_PASSWORD=hsygUVNhuZYKjfAPjFXlORhrMDRFheCT
PG_DATABASE=railway
# Poné en true si tu proveedor (ej. Railway) requiere SSL para conexiones externas
PG_SSL=false

# JWT
JWT_SECRET=super_secret_jwt_key_tactica_flow

# Google OAuth (Issue #6) - Client ID de la credencial OAuth en Google Cloud Console.
# Todavía no existe el valor real (el equipo lo está gestionando); dejar vacío en el repo,
# cada dev lo carga en su .env local.
GOOGLE_CLIENT_ID=

# IA multi-proveedor (Vercel AI SDK) - Issue #8 [EPIC] IA Multi-Provider
# El proveedor/modelo que usa cada usuario es una preferencia guardada en users.ai_provider /
# users.ai_model (configurable desde la extensión). Estas variables son la clave de cada
# proveedor y el modelo de RESPALDO — se usan cuando el usuario todavía no elige nada, o pide
# un proveedor cuya clave no está configurada acá (en ese caso se cae a Gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Sin tope de caracteres de contexto ni de tamaño de archivo para la Base de Conocimiento
# (Issue #7) — a pedido de negocio, "documentos sin límites".

# Táctica ERP API / Server URL
TACTICA_API_URL=http://localhost:3000/api
