PORT=5000
NODE_ENV=development

# Database PostgreSQL
PG_HOST=sakura.proxy.rlwy.net
PG_PORT=19251
PG_USER=postgres
PG_PASSWORD=hsygUVNhuZYKjfAPjFXlORhrMDRFheCT
PG_DATABASE=railway
# Poné en true si tu proveedor (ej. Railway) requiere SSL para conexiones externas
PG_SSL=false

# JWT
JWT_SECRET=super_secret_jwt_key_tactica_flow

# Google OAuth (Issue #6) - Client ID de la credencial OAuth en Google Cloud Console.
# Todavía no existe el valor real (el equipo lo está gestionando); dejar vacío en el repo,
# cada dev lo carga en su .env local.
GOOGLE_CLIENT_ID=

# IA (Vercel AI SDK) - Issue #8 [EPIC] IA Multi-Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Tope de caracteres del contexto de la Base de Conocimiento (Issue #7) inyectado al bot.
# Opcional, default 60000 si no se define.
# KB_MAX_CONTEXT_CHARS=60000
# Tope de peso por archivo subido a la Base de Conocimiento, en MB. Opcional, default 10.
# KB_MAX_FILE_SIZE_MB=10

# OpenAI API Key (reservado para cuando se sume soporte multi-provider, ver Issue #8)
# OPENAI_API_KEY=sk-...

# Táctica ERP API / Server URL
TACTICA_API_URL=http://localhost:3000/api
